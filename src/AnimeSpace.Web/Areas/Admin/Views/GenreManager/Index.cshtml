@model IReadOnlyList<GenreDto>
@{
    ViewData["Title"] = "Жанри";
}

<h1 class="h3 mb-4">Жанри (@Model.Count)</h1>

<form asp-action="Create" method="post" class="row g-2 mb-4">
    <div class="col-auto">
        <input name="Name" class="form-control" placeholder="Назва нового жанру" maxlength="100" required />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Додати</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">Жанрів ще немає.</div>
}
else
{
    <table class="table table-hover align-middle w-auto">
        <thead>
            <tr>
                <th>Назва</th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var genre in Model)
            {
                <tr>
                    <td class="pe-5">@genre.Name</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@genre.Id">Перейменувати</a>
                            <form asp-action="Delete" asp-route-id="@genre.Id" method="post"
                                  data-confirm="Видалити жанр «@genre.Name»? Тайтли залишаться, але втратять цей жанр.">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Видалити</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
