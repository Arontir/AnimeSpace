<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Адмінка AnimeSpace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <nav class="admin-sidebar bg-body-tertiary border-end p-3 flex-shrink-0">
            <a class="d-block fw-bold fs-5 mb-4 text-decoration-none" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">AnimeSpace Admin</a>

            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Статистика</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="AnimeManager" asp-action="Index">Тайтли</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="AnimeManager" asp-action="Create">+ Новий тайтл</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="GenreManager" asp-action="Index">Жанри</a></li>
            </ul>

            <hr />
            <a class="small" asp-area="" asp-controller="Home" asp-action="Index">&larr; На сайт</a>
        </nav>

        <main class="flex-grow-1 p-4">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
