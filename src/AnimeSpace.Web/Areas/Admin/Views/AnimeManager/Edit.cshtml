@model AnimeFormViewModel
@{
    ViewData["Title"] = "Редагування тайтлу";
}

<h1 class="h3 mb-4">Редагування: @Model.Anime.Title</h1>

<form asp-action="Edit" asp-route-id="@Model.Anime.Id" method="post" enctype="multipart/form-data">
    <partial name="_AnimeForm" model="Model" />

    <button class="btn btn-primary" type="submit">Зберегти</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Скасувати</a>
    <a class="btn btn-link" asp-area="" asp-controller="Anime" asp-action="Details" asp-route-id="@Model.Anime.Id">Відкрити на сайті</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
