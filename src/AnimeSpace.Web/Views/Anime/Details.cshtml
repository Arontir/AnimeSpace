@model AnimeDetailsViewModel
@{
    var anime = Model.Anime;
    ViewData["Title"] = anime.Title;

    var poster = string.IsNullOrWhiteSpace(anime.PosterUrl)
        ? Url.Content("~/images/no-poster.svg")
        : anime.PosterUrl;

    var isSignedIn = Model.CurrentUserId is not null;
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="row g-4">
    <div class="col-md-3">
        <img src="@poster" class="img-fluid rounded poster" alt="@anime.Title" />
    </div>

    <div class="col-md-9">
        <h1 class="h3">@anime.Title</h1>

        <p class="text-secondary">
            @anime.ReleaseYear
            · <span class="badge @(anime.Status == AnimeStatus.Ongoing ? "text-bg-success" : "text-bg-secondary")">@anime.Status.ToDisplay()</span>
            ·
            @if (anime.RatingsCount > 0)
            {
                <span id="rating-summary" class="text-warning">★ @anime.AverageRating.ToString("0.0", CultureInfo.InvariantCulture) (@anime.RatingsCount)</span>
            }
            else
            {
                <span id="rating-summary" class="text-secondary">оцінок ще немає</span>
            }
        </p>

        <p>
            @foreach (var genre in anime.Genres)
            {
                <a class="badge text-bg-secondary text-decoration-none"
                   asp-controller="Anime" asp-action="Catalog" asp-route-GenreId="@genre.Id">@genre.Name</a>
            }
        </p>

        @if (!string.IsNullOrWhiteSpace(anime.Description))
        {
            <p class="comment-text">@anime.Description</p>
        }

        @if (isSignedIn)
        {
            <div class="d-flex flex-wrap gap-3 align-items-center mt-3">

                <div class="d-flex align-items-center gap-2" data-bookmark-box>
                    <select class="form-select form-select-sm w-auto" data-bookmark-select
                            data-anime-id="@anime.Id" aria-label="Статус у списку">
                        <option value="">Додати до списку…</option>
                        @foreach (var status in Enum.GetValues<WatchStatus>())
                        {
                            <option value="@((int)status)" selected="@(Model.CurrentUserBookmarkStatus == status)">@status.ToDisplay()</option>
                        }
                    </select>
                    <button type="button" data-bookmark-remove data-anime-id="@anime.Id"
                            class="btn btn-sm btn-outline-secondary @(Model.CurrentUserBookmarkStatus is null ? "d-none" : "")">Прибрати</button>
                    <span class="small" data-bookmark-feedback></span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select id="rating-select" class="form-select form-select-sm w-auto"
                            data-anime-id="@anime.Id" aria-label="Ваша оцінка">
                        <option value="">Ваша оцінка…</option>
                        @for (var score = 10; score >= 1; score--)
                        {
                            <option value="@score" selected="@(Model.CurrentUserRating == score)">@score</option>
                        }
                    </select>
                    <span id="rating-feedback" class="small"></span>
                </div>
            </div>
        }
        else
        {
            <p class="small text-secondary mt-3">
                <a asp-area="Identity" asp-page="/Account/Login"
                   asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Увійдіть</a>,
                щоб оцінювати, додавати тайтли до списку та коментувати.
            </p>
        }
    </div>
</div>

<hr class="my-4" />

<h2 class="h5">Перегляд</h2>

@if (string.IsNullOrWhiteSpace(anime.PlayerUrl))
{
    <div class="alert alert-secondary">Відео ще не додано.</div>
}
else
{
    <div class="ratio ratio-16x9 bg-black rounded overflow-hidden">
        <iframe src="@anime.PlayerUrl"
                title="Відеоплеєр"
                allowfullscreen
                allow="autoplay; fullscreen; picture-in-picture"
                referrerpolicy="strict-origin-when-cross-origin"
                loading="lazy"></iframe>
    </div>
}

<h2 class="h5 mt-5" id="comments">Коментарі (<span id="comment-count">@Model.Comments.Count</span>)</h2>

@if (isSignedIn)
{
    <form id="comment-form" class="mb-4" data-anime-id="@anime.Id">
        <textarea name="text" class="form-control mb-2" rows="3" maxlength="2000" required
                  placeholder="Напишіть коментар…"></textarea>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary btn-sm" type="submit">Надіслати</button>
            <span id="comment-feedback" class="small"></span>
        </div>
    </form>
}

<p id="no-comments" class="text-secondary @(Model.Comments.Count > 0 ? "d-none" : "")">Коментарів ще немає.</p>

<div id="comment-list">
    @foreach (var comment in Model.Comments)
    {
        <div class="border-bottom py-3 comment-item" data-comment-id="@comment.Id">
            <div class="d-flex justify-content-between">
                <div>
                    <strong class="comment-author">@comment.UserName</strong>
                    <small class="text-secondary ms-2 comment-date">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm") UTC</small>
                </div>

                @if (isSignedIn && (isAdmin || comment.UserId == Model.CurrentUserId))
                {
                    <button type="button" class="btn btn-link btn-sm text-danger p-0 comment-delete"
                            data-comment-id="@comment.Id">Видалити</button>
                }
            </div>
            <div class="comment-text">@comment.Text</div>
        </div>
    }
</div>

<template id="comment-template">
    <div class="border-bottom py-3 comment-item">
        <div class="d-flex justify-content-between">
            <div>
                <strong class="comment-author"></strong>
                <small class="text-secondary ms-2 comment-date"></small>
            </div>
            <button type="button" class="btn btn-link btn-sm text-danger p-0 comment-delete">Видалити</button>
        </div>
        <div class="comment-text"></div>
    </div>
</template>

@section Scripts {
    <script src="~/js/anime-details.js" asp-append-version="true"></script>
    <script src="~/js/bookmarks.js" asp-append-version="true"></script>
}
