@model HomeViewModel
@{
    ViewData["Title"] = "Головна";
}

@if (Model.LatestReleases.Count > 0)
{
    <div id="latestCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
        @if (Model.LatestReleases.Count > 1)
        {
            <div class="carousel-indicators">
                @for (var i = 0; i < Model.LatestReleases.Count; i++)
                {
                    <button type="button" data-bs-target="#latestCarousel" data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")" aria-label="Слайд @(i + 1)"></button>
                }
            </div>
        }

        <div class="carousel-inner rounded">
            @for (var i = 0; i < Model.LatestReleases.Count; i++)
            {
                var anime = Model.LatestReleases[i];
                var poster = string.IsNullOrWhiteSpace(anime.PosterUrl)
                    ? Url.Content("~/images/no-poster.svg")
                    : anime.PosterUrl;

                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="hero-slide d-flex align-items-center gap-4 p-4">
                        <img src="@poster" alt="@anime.Title" class="hero-poster rounded d-none d-sm-block" />
                        <div>
                            <h2 class="h3">@anime.Title</h2>
                            <p class="text-secondary mb-3">
                                @anime.ReleaseYear · @anime.Status.ToDisplay()
                                @if (anime.GenreNames.Count > 0)
                                {
                                    <span> · @string.Join(", ", anime.GenreNames)</span>
                                }
                            </p>
                            <a class="btn btn-primary" asp-controller="Anime" asp-action="Details" asp-route-id="@anime.Id">Дивитися</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.LatestReleases.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#latestCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Попередній</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#latestCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Наступний</span>
            </button>
        }
    </div>
}

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="h4 mb-0">Онгоїнги</h2>
        <a class="small" asp-controller="Anime" asp-action="Catalog" asp-route-Status="@((int)AnimeStatus.Ongoing)">Усі онгоїнги</a>
    </div>

    @if (Model.Ongoing.Count == 0)
    {
        <p class="text-secondary">Поки що немає.</p>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var anime in Model.Ongoing)
            {
                <partial name="_AnimeCard" model="anime" />
            }
        </div>
    }
</section>

<section class="mb-4">
    <h2 class="h4 mb-3">Топ-10 за рейтингом</h2>

    @if (Model.TopRated.Count == 0)
    {
        <p class="text-secondary">Поки що немає.</p>
    }
    else
    {
        <ol class="list-group list-group-numbered">
            @foreach (var anime in Model.TopRated)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a class="ms-2 me-auto text-decoration-none" asp-controller="Anime" asp-action="Details" asp-route-id="@anime.Id">@anime.Title</a>
                    @if (anime.RatingsCount > 0)
                    {
                        <span class="badge text-bg-warning">★ @anime.AverageRating.ToString("0.0", CultureInfo.InvariantCulture)</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">без оцінок</span>
                    }
                </li>
            }
        </ol>
    }
</section>
