@using Microsoft.AspNetCore.WebUtilities
@model PagedResult<AnimeCardDto>
@{
    var baseQuery = Context.Request.Query
        .Where(q => !string.Equals(q.Key, "Page", StringComparison.OrdinalIgnoreCase))
        .ToDictionary(q => q.Key, q => (string?)q.Value.ToString());

    string PageUrl(int p)
    {
        var query = new Dictionary<string, string?>(baseQuery) { ["Page"] = p.ToString() };
        return QueryHelpers.AddQueryString(Context.Request.Path.Value ?? "/", query);
    }

    var current = Model.PageNumber;
    var total = Model.TotalPages;

    var first = Math.Max(1, current - 2);
    var last = Math.Min(total, current + 2);
}

@if (total > 1)
{
    <nav class="mt-4" aria-label="Сторінки">
        <ul class="pagination justify-content-center">
            <li class="page-item @(current <= 1 ? "disabled" : "")">
                <a class="page-link" href="@(current <= 1 ? "#" : PageUrl(current - 1))" aria-label="Попередня">&laquo;</a>
            </li>

            @for (var p = first; p <= last; p++)
            {
                <li class="page-item @(p == current ? "active" : "")">
                    <a class="page-link" href="@PageUrl(p)">@p</a>
                </li>
            }

            <li class="page-item @(current >= total ? "disabled" : "")">
                <a class="page-link" href="@(current >= total ? "#" : PageUrl(current + 1))" aria-label="Наступна">&raquo;</a>
            </li>
        </ul>
    </nav>
}
