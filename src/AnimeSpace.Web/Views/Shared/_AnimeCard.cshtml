@model AnimeCardDto
@{
    var poster = string.IsNullOrWhiteSpace(Model.PosterUrl)
        ? Url.Content("~/images/no-poster.svg")
        : Model.PosterUrl;
}

<div class="col">
    <div class="card h-100 anime-card">
        <img src="@poster" class="card-img-top poster" alt="@Model.Title" loading="lazy" />
        <div class="card-body p-2">
            <a class="stretched-link text-decoration-none fw-semibold"
               asp-controller="Anime" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
            <div class="small text-secondary">
                @Model.ReleaseYear · @Model.Status.ToDisplay()
                @if (Model.RatingsCount > 0)
                {
                    <span class="ms-1 text-warning">★ @Model.AverageRating.ToString("0.0", CultureInfo.InvariantCulture)</span>
                }
            </div>
        </div>
    </div>
</div>
