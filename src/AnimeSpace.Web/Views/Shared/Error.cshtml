@model ErrorViewModel
@{
    ViewData["Title"] = "Помилка";
}

<h1 class="text-danger">Щось пішло не так</h1>
<p>Під час обробки запиту сталася помилка. Спробуйте ще раз трохи пізніше.</p>

@if (Model.ShowRequestId)
{
    <p class="small text-secondary">Ідентифікатор запиту: <code>@Model.RequestId</code></p>
}

<a class="btn btn-primary" asp-controller="Home" asp-action="Index">На головну</a>
